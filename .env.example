# Shopify
SHOPIFY_SHOP_NAME=your_shop_name
SHOPIFY_API_KEY=your_api_key
SHOPIFY_ACCESS_TOKEN=your_access_token

# JWT
JWT_SECRET=your_jwt_secret

# MyPOS API
API_BASE_URL=http://124.43.76.8:9093
API_USERNAME=HLA0000
API_PASSWORD=your_password

# MyPOS working hours (24h format, when MyPOS computer is ON).
# Orders received outside these hours are queued and auto-delivered when MyPOS is back online.
# Weekdays (Mon-Fri): MyPOS online 08:30 - 19:00 (off 19:00 -> 08:30 next day)
# Weekends (Sat-Sun): MyPOS online 10:00 - 19:00 (off 19:00 -> 10:00 next day)
MYPOS_WEEKDAY_START=08:30
MYPOS_WEEKDAY_END=19:00
MYPOS_WEEKEND_START=10:00
MYPOS_WEEKEND_END=19:00
MYPOS_TIMEZONE=Asia/Colombo

# How often (ms) the retry job tries to flush queued orders. Default 5 min.
QUEUE_RETRY_INTERVAL_MS=300000
